# AI Revenue Recovery Engine — environment variables.
# Copy to .env and fill in. Every value below is read via os.environ.get()
# with an empty-string default, so the whole system boots and runs with
# none of these set — each credentialed client fails only at the point of
# actual use, with a clear message naming exactly which variable is missing.

# --- LLM + embeddings (OpenRouter — one key covers both) ---------------------
# Sign up: https://openrouter.ai  ->  add credits  ->  generate a key at
# https://openrouter.ai/keys. Verify the exact current model slugs at
# https://openrouter.ai/models before relying on the defaults below — this
# project's own history already shows model names go stale fast.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# --- Razorpay ----------------------------------------------------------------
# Test-mode keys: Razorpay Dashboard -> Settings -> API Keys (generate test key).
# Webhook secret: Dashboard -> Settings -> Webhooks -> (create one pointing at
# POST /webhooks/razorpay on this backend's public URL) -> set a secret there,
# then paste the same value here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Meta WhatsApp Cloud API ---------------------------------------------------
# Meta for Developers -> create an app (Business type) -> add the WhatsApp
# product -> a test number and WABA are provisioned automatically.
# ACCESS_TOKEN / PHONE_NUMBER_ID: from the WhatsApp product's Getting Started page.
# APP_SECRET: App Settings -> Basic.
# VERIFY_TOKEN: any string you choose yourself — enter the SAME string when
# configuring the webhook (Configuration -> Webhooks -> Verify Token) and here.
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=

# --- Internal escalation email (Problem 9 -> procurement/finance) ------------
# Any SMTP account works (e.g. a Gmail account with an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Infra connection strings (defaults match this project's local setup) ----
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=revenue_recovery
REDIS_URL=redis://localhost:6379/0
# The RAG deployment's connection string is not env-configurable yet - it's
# hardcoded in libs/rzp_common/rag_mongo_client.py to mongodb://localhost:27018
# (the mongodb-atlas-local Docker container's exposed port).
